#!/bin/bash
# =============================================================================
#  tmxssh  -  start an OpenSSH server on Termux so other devices
#             (laptops, phones, tablets) can SSH INTO this device over LAN.
#
#  Author : Hari (Daemon-018)
#  License: MIT  |  Free & open source
#  Repo   : https://github.com/Daemon-018/tmxssh
#
#  Usage  : tmxssh            -> ensure running, show connection info
#           tmxssh start      -> start sshd in the background
#           tmxssh stop       -> stop sshd
#           tmxssh status     -> show running state + info
#           tmxssh setpass    -> set/change the SSH login password
#           tmxssh port N     -> set SSH server port (default 8022)
#           tmxssh info       -> show connection details (IP/port/user)
#           tmxssh qr         -> show a QR code with the full ssh command
#           tmxssh version    -> show the version
#           tmxssh help       -> this help
# =============================================================================

# ---------- config -----------------------------------------------------------
TMXSSH_VERSION="1.1.0"
TMXSSH_HOME="${TMXSSH_HOME:-$HOME/.tmxssh}"
CONF_FILE="$TMXSSH_HOME/config"
DEFAULT_PORT=8022
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"

# ---------- cyberpunk theme --------------------------------------------------
C_RESET=$'\033[0m'
C_DIM=$'\033[2m'
C_GREEN=$'\033[38;5;48m'     # neon green  #00ff9f
C_CYAN=$'\033[38;5;51m'      # cyber cyan  #00e5ff
C_PINK=$'\033[38;5;206m'     # synth pink  #ff3bd4
C_AMBER=$'\033[38;5;227m'    # amber       #ffd75f
C_RED=$'\033[38;5;203m'      # volt red    #ff5f5f
C_PURPLE=$'\033[38;5;141m'   # neon purple #af87ff

# ---------- helpers ----------------------------------------------------------
say(){ printf '%s\n' "$*"; }
ok(){  printf '%s[ OK ]%s %s%s%s\n' "$C_GREEN" "$C_RESET" "$C_PINK" "$*" "$C_RESET"; }
warn(){ printf '%s[ WARN ]%s %s%s%s\n' "$C_AMBER" "$C_RESET" "$C_DIM" "$*" "$C_RESET"; }
err(){ printf '%s[ ERROR ]%s %s%s%s\n' "$C_RED" "$C_RESET" "$C_PINK" "$*" "$C_RESET" >&2; }
die(){ err "$*"; exit 1; }

# ---------- auto-adjust to screen --------------------------------------------
# Detect terminal width once. Falls back to a sane default when not a TTY
# (piped output, cron, tests) so output never depends on the environment.
TERM_COLS="${COLUMNS:-}"
if [ -z "$TERM_COLS" ]; then
  TERM_COLS=$(tput cols 2>/dev/null) \
    || TERM_COLS=$(stty size 2>/dev/null | awk '{print $2}') \
    || TERM_COLS=80
fi
[ "$TERM_COLS" -ge 40 ] 2>/dev/null || TERM_COLS=80
[ "$TERM_COLS" -le 220 ] 2>/dev/null || TERM_COLS=220

# repeat a glyph N times (string builder — portable)
rep(){ local i s=""; for ((i=0;i<$2;i++)); do s+="$1"; done; printf '%s' "$s"; }

# dividers stretch to screen width
hrule(){  printf '%s%s%s\n' "$C_CYAN" "$(rep '─' "$TERM_COLS")" "$C_RESET"; }
hrule2(){ printf '%s%s%s\n' "$C_PINK" "$(rep '═' "$TERM_COLS")" "$C_RESET"; }

# banner: neon tmxssh logo + attribution (centers to screen width)
pad(){ local n=$1; [ "$n" -lt 0 ] && n=0; rep ' ' "$n"; }
banner(){
  local w=$((TERM_COLS/2)) p p2
  p=$((w-26)); p2=$((w-30))
  echo ""
  printf '%s%s%s\n' "$C_GREEN" "$(pad "$p")"    "    ████████╗███╗   ███╗██╗  ██╗███████╗███████╗██╗  ██╗"
  printf '%s%s%s\n' "$C_GREEN" "$(pad "$p")"    "    ╚══██╔══╝████╗ ████║╚██╗██╔╝██╔════╝██╔════╝██║  ██║"
  printf '%s%s%s\n' "$C_GREEN" "$(pad "$p")"    "       ██║   ██╔████╔██║ ╚███╔╝ ███████╗███████╗███████║"
  printf '%s%s%s\n' "$C_GREEN" "$(pad "$p")"    "       ██║   ██║╚██╔╝██║ ██╔██╗ ╚════██║╚════██║██╔══██║"
  printf '%s%s%s\n' "$C_GREEN" "$(pad "$p")"    "       ██║   ██║ ╚═╝ ██║██╔╝ ██╗███████║███████║██║  ██║"
  printf '%s%s%s\n' "$C_GREEN" "$(pad "$p")"    "       ╚═╝   ╚═╝     ╚═╝╚═╝  ╚═╝╚══════╝╚══════╝╚═╝  ╚═╝"
  printf '%s%s%s%s%s\n' "$C_DIM" "$(pad "$p2")" ":: OPENSSH NEON SERVER v$TMXSSH_VERSION ::" "$C_RESET" "  $C_PURPLE@daemon-018$C_RESET"
  echo ""
}

get_user(){ whoami; }

get_ssh_port(){
  # prefer configured port, else whatever sshd_config says, else default
  local p=""
  if [ -r "$CONF_FILE" ]; then
    p=$(sed -n 's/^port=//p' "$CONF_FILE" 2>/dev/null | tail -n 1)
  fi
  case "$p" in ''|*[!0-9]*) p="" ;; esac
  if [ -z "$p" ] && [ -f "$PREFIX/etc/ssh/sshd_config" ]; then
    p=$(sed -n 's/^[[:space:]]*Port[[:space:]]*//p' "$PREFIX/etc/ssh/sshd_config" 2>/dev/null | tail -n 1)
    case "$p" in ''|*[!0-9]*) p="" ;; esac
  fi
  echo "${p:-$DEFAULT_PORT}"
}

get_lan_ips(){
  # collect IPv4 addresses of this device
  { ip -4 addr show 2>/dev/null | sed -n 's/.*inet \([0-9.]*\)\/.*/\1/p';
    ifconfig 2>/dev/null | sed -n 's/.*inet \([0-9.]*\) .*/\1/p'; } \
    | grep -vE '^(127\.|192\.0\.0\.)' | sort -u
}

ssh_running(){ pgrep -x sshd >/dev/null 2>&1; }

# ---------- config persistence ----------------------------------------------
# Only a known allow-list of keys is ever read. Values are validated, never
# evaluated, so a tampered config file cannot execute commands.
load_config(){
  [ -r "$CONF_FILE" ] || return 0
  local k v n
  while IFS='=' read -r k v || [ -n "$k" ]; do
    v="${v%$'\r'}"
    case "$k" in
      ''|\#*) continue ;;          # blank line or comment
      port)
        case "$v" in
          ''|*[!0-9]*)
            warn "ignoring invalid port in $CONF_FILE: '$v'" ;;
          *)
            if [ "${#v}" -gt 5 ]; then
              warn "ignoring out-of-range port in $CONF_FILE: $v"
            else
              n=$((10#$v))
              if [ "$n" -ge 1 ] && [ "$n" -le 65535 ]; then
                SSH_PORT="$n"
              else
                warn "ignoring out-of-range port in $CONF_FILE: $v"
              fi
            fi ;;
        esac ;;
      *) : ;;                      # unknown keys are ignored (no eval)
    esac
  done < "$CONF_FILE"
}
save_config(){
  SSH_PORT="${SSH_PORT:-$DEFAULT_PORT}"
  mkdir -p "$TMXSSH_HOME" || die "cannot create $TMXSSH_HOME"
  ( umask 077; printf 'port=%s\n' "$SSH_PORT" > "$CONF_FILE" ) \
    || die "cannot write $CONF_FILE"
  chmod 600 "$CONF_FILE" 2>/dev/null
}

# ---------- core actions ----------------------------------------------------
requires_openssh(){
  if ! command -v sshd >/dev/null 2>&1; then
    say "  -> installing openssh (needed to run the SSH server)..."
    if command -v pkg >/dev/null 2>&1; then
      pkg install -y openssh >/dev/null 2>&1 \
        || die "could not install openssh. run: pkg install openssh"
    elif command -v apt >/dev/null 2>&1; then
      apt install -y openssh-server >/dev/null 2>&1 \
        || die "could not install openssh-server. run it with sudo, then retry"
    else
      die "sshd is missing. install openssh-server with your package manager"
    fi
  fi
  command -v sshd >/dev/null 2>&1 || die "sshd still not available after install"
}

write_sshd_config_port(){
  local conf="$PREFIX/etc/ssh/sshd_config"
  [ -f "$conf" ] || return 0
  grep -q "^[[:space:]]*Port" "$conf" \
    && sed -i "s/^[[:space:]]*Port.*/Port $SSH_PORT/" "$conf" \
    || printf '\nPort %s\n' "$SSH_PORT" >> "$conf"
}

ensure_key(){
  if [ ! -f "$HOME/.ssh/id_ed25519" ]; then
    mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
    ssh-keygen -q -t ed25519 -N "" -f "$HOME/.ssh/id_ed25519" >/dev/null 2>&1 \
      && say "  -> generated an SSH key pair for this device"
  fi
}

ensure_password(){
  # Termux ships with no login password; set one on first run.
  local marker="$TMXSSH_HOME/.pwset"
  [ -f "$marker" ] && return 0

  mkdir -p "$TMXSSH_HOME"
  say ""
  say "  Your Termux has no SSH login password yet."
  say "  Set one now (used by other devices to log in)."
  say ""
  passwd || die "password setup cancelled"
  ( umask 077; : > "$marker" )
  ok "SSH login password set"
}

cmd_start(){
  requires_openssh
  ensure_key

  banner
  load_config
  SSH_PORT="${SSH_PORT:-$DEFAULT_PORT}"
  write_sshd_config_port
  save_config

  # make sure .ssh perms are right
  chmod 700 "$HOME/.ssh" 2>/dev/null
  [ -f "$HOME/.ssh/authorized_keys" ] && chmod 600 "$HOME/.ssh/authorized_keys" 2>/dev/null

  if ssh_running; then
    warn "sshd is already running"
  else
    pkill -x sshd 2>/dev/null
    sshd 2>/dev/null
    sleep 1
    if ssh_running; then
      ok "SSH server started (background)"
    else
      die "failed to start sshd"
    fi
  fi
  cmd_info
}

cmd_stop(){
  if ssh_running; then
    pkill -x sshd; sleep 1
    if ssh_running; then
      err "could not stop sshd"
    else
      ok "SSH server stopped"
    fi
  else
    warn "sshd is not running"
  fi
}

cmd_status(){
  load_config
  SSH_PORT="${SSH_PORT:-$DEFAULT_PORT}"
  hrule
  printf '%s[ %sSTATUS%s ]%s %stmxssh%s\n' "$C_DIM" "$C_CYAN" "$C_RESET" "$C_DIM" "$C_PINK" "$C_RESET"
  hrule2
  if ssh_running; then
    printf '%s░░%s Server   : %s● RUNNING%s\n' "$C_DIM" "$C_RESET" "$C_GREEN" "$C_RESET"
    printf '%-12s : %s%s%s\n' 'Port' "$C_CYAN" "$(get_ssh_port)" "$C_RESET"
  else
    printf '%s░░%s Server   : %s● STOPPED%s  (tmxssh start)\n' "$C_DIM" "$C_RESET" "$C_RED" "$C_RESET"
    printf '%-12s : %s%s%s\n' 'Port' "$C_CYAN" "$(get_ssh_port)" "$C_RESET"
  fi
  printf '%-12s : %s%s%s\n' 'User' "$C_GREEN" "$(get_user)" "$C_RESET"
  printf '%-12s : %s%s%s\n' 'Key file' "$C_DIM" "$HOME/.ssh/id_ed25519.pub" "$C_RESET"
  hrule
}

cmd_info(){
  load_config
  SSH_PORT="${SSH_PORT:-$DEFAULT_PORT}"
  local user; user="$(get_user)"

  echo ""
  printf '%s[ ACCESS GRANTED ]%s  connect from another device:\n' "$C_GREEN" "$C_RESET"
  echo ""
  local ip ips; ips="$(get_lan_ips)"
  for ip in $ips; do
    printf '    %s$%s %s%s -p %s %s@%s%s\n' "$C_PINK" "$C_RESET" "$C_CYAN" "ssh" "$SSH_PORT" "$user" "$ip" "$C_RESET"
  done
  [ -z "$ips" ] && {
    printf '    %s(no LAN IP detected — run: ip addr)%s\n' "$C_AMBER" "$C_RESET"
  }
  echo ""
  printf '%s  password   :%s the one set with tmxssh setpass\n' "$C_DIM" "$C_RESET"
  printf '%s  hints      :%s tmxssh help%s · %s@daemon-018%s\n' "$C_DIM" "$C_RESET" "$C_CYAN" "$C_PURPLE" "$C_RESET"
  echo ""
}

cmd_setpass(){
  mkdir -p "$TMXSSH_HOME"
  say "  Set a new SSH login password for user '$(get_user)':"
  passwd || die "password change cancelled/failed"
  ( umask 077; : > "$TMXSSH_HOME/.pwset" )
  ok "SSH login password updated"
}

cmd_port(){
  [ -n "$1" ] || die "usage: tmxssh port <NUMBER>"
  case "$1" in
    *[!0-9]*) die "port must be a number";;
  esac
  if [ "${#1}" -gt 5 ]; then
    die "port out of range (1-65535)"
  fi
  local n=$((10#$1))
  if [ "$n" -lt 1 ] || [ "$n" -gt 65535 ]; then
    die "port out of range (1-65535)"
  fi
  load_config; SSH_PORT="$n"; save_config
  write_sshd_config_port
  ok "SSH port set to $n"
  if ssh_running; then
    warn "restart to apply: tmxssh restart"
  fi
}

cmd_noargs(){
  load_config
  SSH_PORT="${SSH_PORT:-$DEFAULT_PORT}"
  banner
  if [ ! -f "$TMXSSH_HOME/.pwset" ]; then
    say "  ${C_CYAN}== tmxssh first-run setup ==${C_RESET}"
    ensure_password
  fi
  if ! ssh_running; then
    requires_openssh; ensure_key
    write_sshd_config_port; save_config
    pkill -x sshd 2>/dev/null
    sshd 2>/dev/null; sleep 1
  fi
  cmd_info
}

cmd_qr(){
  load_config
  SSH_PORT="${SSH_PORT:-$DEFAULT_PORT}"
  local user; user="$(get_user)"
  local ip; ip="$(get_lan_ips | head -1)"
  [ -n "$ip" ] || die "could not detect LAN IP"
  local conn="ssh -p $SSH_PORT $user@$ip"
  say "  Scan this with any phone camera / QR reader to get the connect command:"
  echo ""
  if command -v qrencode >/dev/null 2>&1; then
    echo "$conn" | qrencode -t ANSI 2>/dev/null \
      || echo "$conn" | qrencode -t ANSI256 2>/dev/null \
      || { say "$conn"; warn "install qrencode for a QR code: pkg install qrencode"; }
  elif command -v python3 >/dev/null 2>&1 && python3 -c "import qrcode" 2>/dev/null; then
    python3 - "$conn" <<'PY'
import sys, qrcode
q = qrcode.QRCode()
q.add_data(sys.argv[1]); q.make()
q.print_ascii(invert=True)
PY
  else
    say "  $conn"
    warn "install 'qrencode' (pkg install qrencode) to show a scannable QR code."
  fi
  echo ""
}

cmd_help(){
  banner
  hrule
  printf '%s[ %sHELP%s ]%s  tmxssh — start OpenSSH on Termux, others SSH in over LAN\n' "$C_DIM" "$C_CYAN" "$C_RESET" "$C_RESET"
  hrule2
  printf '  %s%-12s%s  %sauto-start (if needed) + show connect info%s\n' "$C_PINK" 'tmxssh' "$C_RESET" "$C_RESET" ""
  printf '  %s%-12s%s  %sstart sshd in background + show info%s\n' "$C_PINK" 'tmxssh start' "$C_RESET" "$C_RESET" ""
  printf '  %s%-12s%s  %sstop sshd%s\n' "$C_PINK" 'tmxssh stop' "$C_RESET" "$C_RESET" ""
  printf '  %s%-12s%s  %srestart sshd%s\n' "$C_PINK" 'tmxssh restart' "$C_RESET" "$C_RESET" ""
  printf '  %s%-12s%s  %sshow running state%s\n' "$C_PINK" 'tmxssh status' "$C_RESET" "$C_RESET" ""
  printf '  %s%-12s%s  %sshow IP/port/user to connect with%s\n' "$C_PINK" 'tmxssh info' "$C_RESET" "$C_RESET" ""
  printf '  %s%-12s%s  %sset/change SSH login password%s\n' "$C_PINK" 'tmxssh setpass' "$C_RESET" "$C_RESET" ""
  printf '  %s%-12s%s  %schange SSH port (default 8022)%s\n' "$C_PINK" 'tmxssh port N' "$C_RESET" "$C_RESET" ""
  printf '  %s%-12s%s  %sshow scannable QR connect code%s\n' "$C_PINK" 'tmxssh qr' "$C_RESET" "$C_RESET" ""
  printf '  %s%-12s%s  %sshow version%s\n' "$C_PINK" 'tmxssh version' "$C_RESET" "$C_RESET" ""
  printf '  %s%-12s%s  %sshow this help%s\n' "$C_PINK" 'tmxssh help' "$C_RESET" "$C_RESET" ""
  hrule
  printf '%s  crafted by %s@daemon-018%s · %shttps://github.com/Daemon-018/tmxssh%s\n' "$C_DIM" "$C_PURPLE" "$C_DIM" "$C_CYAN" "$C_RESET"
  hrule
}

cmd_version(){
  printf '%s%s%s\n' "$C_GREEN" "tmxssh $TMXSSH_VERSION" "$C_RESET"
}

cmd_restart(){
  cmd_stop
  sleep 1
  cmd_start
}

# ---------- entry point ------------------------------------------------------
main(){
  case "${1:-}" in
    start)   cmd_start ;;
    stop)    cmd_stop ;;
    status)  cmd_status ;;
    info)    cmd_info ;;
    setpass) cmd_setpass ;;
    qr)      cmd_qr ;;
    port)    cmd_port "$2" ;;
    restart) cmd_restart ;;
    version|--version|-v) cmd_version ;;
    help|-h|--help) cmd_help ;;
    *)       cmd_noargs ;;
  esac
}

# Only run when executed, not when sourced (lets tests load the functions).
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
